-- 1 -> 2: the filter values, remembered.
--
-- This project's first migration. Everything before it shipped at schema 1, and an install from
-- then has every table this one does except `game_facets` -- so the migration is a create and
-- nothing else. No data moves and nothing is rewritten.
--
-- The table is a cache of values that can always be recomputed from `printing`, so an install that
-- somehow arrives without it loses a few hundred milliseconds on the next search screen and
-- nothing else. That is why it was safe to make this the first migration rather than a harder one.
CREATE TABLE game_facets (
    game        TEXT    NOT NULL PRIMARY KEY,
    row_count   INTEGER NOT NULL,
    card_types  TEXT    NOT NULL,
    rarities    TEXT    NOT NULL,
    domains     TEXT    NOT NULL,
    costs       TEXT    NOT NULL,
    treatments  TEXT    NOT NULL
);
