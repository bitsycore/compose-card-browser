-- One row per printing, per language.
--
-- The shape is deliberately the same identity the file cache uses: (provider, set, language) keys
-- a *set*, and (provider, card id, language) keys a printing. A schema that collapsed language
-- into a column would throw away the thing every layer of this app keys on.
--
-- `payload` is the serialised `CardPrinting`, exactly as the file cache stores it. The indexed
-- columns beside it are a projection for querying, not a second source of truth -- so a field this
-- spike does not model cannot be silently lost, and adding a filter later is a column and a
-- backfill rather than a migration of the record itself.
--
-- Nullable where the source said nothing. `cost` is NULL for a card with no cost *and* for a
-- source that does not publish one, and those are different facts -- the app's `Availability` has
-- three states for exactly this reason. A query that wants "cost under 4" must not sweep up
-- unknowns, so the predicates below test `IS NOT NULL` explicitly.
CREATE TABLE printing (
    provider      TEXT    NOT NULL,
    card_id       TEXT    NOT NULL,
    game          TEXT    NOT NULL,
    set_id        TEXT    NOT NULL,
    set_code      TEXT    NOT NULL,
    language      TEXT    NOT NULL,
    name          TEXT    NOT NULL,
    name_folded   TEXT    NOT NULL,
    card_type     TEXT,
    rarity        TEXT,
    cost          INTEGER,
    domains       TEXT,
    payload       TEXT    NOT NULL,
    PRIMARY KEY (provider, card_id, language)
);

-- Set membership is the commonest lookup by far: open a set, read its cards.
CREATE INDEX printing_set ON printing (provider, set_id, language);

-- Cross-set search, which is the query the file cache genuinely cannot do.
CREATE INDEX printing_name ON printing (game, name_folded);

-- The advanced search's narrowing columns, one index per axis it filters on.
--
-- All three lead with `game`, because every query this app makes is about one game -- a search is
-- launched from a game's set list and there is no "search everything". That prefix is what lets
-- SQLite use the index at all for those queries.
--
-- What these do *not* help is the text predicate. `name_folded LIKE '%annie%'` has a leading
-- wildcard, and no B-tree index can serve one: SQLite has to look at every row it is given. That is
-- exactly why the rest are worth having -- with a type or a rarity chosen, the scan the text
-- predicate has to do is over what those left behind rather than over the game.
--
-- The usual answer for the text half is FTS5, and it was considered and not taken: it would have to
-- work on Android's bundled SQLite, on the JVM driver, and on the two native ones, and this project
-- cannot run three of those four. A trigram index is the other option and costs the write path.
-- Neither is worth adding unverified for a search over a set of at most a few hundred thousand rows.
CREATE INDEX printing_type ON printing (game, card_type);
CREATE INDEX printing_rarity ON printing (game, rarity);
CREATE INDEX printing_cost ON printing (game, cost);

-- What a download put on disk, so eviction and the storage screen can work in SQL rather than by
-- walking a directory. `pinned` is a flag rather than a separate table because it is one bit and
-- every query that cares about it also wants the row.
CREATE TABLE cached_set (
    provider    TEXT    NOT NULL,
    set_id      TEXT    NOT NULL,
    language    TEXT    NOT NULL,
    -- Which game, as a column.
    --
    -- The file cache had to encode this into a pin marker's contents -- `game	setId	language`
    -- -- because a hashed filename says nothing about what it holds, and the storage screen had
    -- to parse it back out. Two places split that string and they were one edit from disagreeing.
    game        TEXT    NOT NULL DEFAULT '',
    -- What to call this set on screen. A *name*, now that the tuple above is not smuggled through
    -- it, so a downloaded set can still be named after everything else is cleared.
    label       TEXT    NOT NULL,
    pinned      INTEGER NOT NULL DEFAULT 0,
    fetched_at  INTEGER NOT NULL,
    card_count  INTEGER NOT NULL,
    -- Whether every page was fetched. A partial set is cached too -- that is the whole point of
    -- `Completeness` -- and the grid says so on screen. Storing it is what keeps a filter applied
    -- to three of four pages from being presented as the answer for the set.
    complete    INTEGER NOT NULL DEFAULT 1,
    -- What this set occupies, so the budget is a SUM rather than a directory walk. Counted at
    -- write time from the payloads actually stored -- an estimate of the rows, not of the file,
    -- because SQLite's own page overhead is not a thing a user's ceiling should be spent on.
    bytes       INTEGER NOT NULL DEFAULT 0,
    -- Least-recently-*used*, not written. The file cache tracked this in memory and lost the
    -- ordering on every relaunch, which made a downloaded set and a glanced-at one look equally
    -- old. A column survives the process, which is the whole reason to move it here.
    accessed_at INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (provider, set_id, language)
);

-- Eviction reads in this order every time.
CREATE INDEX cached_set_evictable ON cached_set (pinned, accessed_at);

upsertPrinting:
INSERT OR REPLACE INTO printing (
    provider, card_id, game, set_id, set_code, language,
    name, name_folded, card_type, rarity, cost, domains, payload
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertCachedSet:
INSERT OR REPLACE INTO cached_set (
    provider, set_id, language, game, label, pinned, fetched_at, card_count, complete, bytes,
    accessed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- The set-open path.
printingsInSet:
SELECT payload FROM printing
WHERE provider = ? AND set_id = ? AND language = ?;

-- The storage screen, which is four directory walks today.
cachedSetCount:
SELECT COUNT(*) FROM cached_set;

pinnedSetCount:
SELECT COUNT(*) FROM cached_set WHERE pinned = 1;

printingCount:
SELECT COUNT(*) FROM printing;

languageBreakdown:
SELECT language, COUNT(*) AS total FROM cached_set GROUP BY language ORDER BY total DESC;

-- The prize: a filtered search across every downloaded set of a game, in one query.
--
-- Every predicate is opt-in via a NULL guard, which is how one statement serves a filter sheet
-- with any combination of chips set. `:excludeText` is the "does not contain" half the file cache
-- has no way to offer at all.
--
-- Each of type and rarity has *two* parameters, and exactly one is ever non-null. Picking one value
-- is an equality, which the `printing_type` and `printing_rarity` indexes serve; picking several is
-- a bar-delimited list -- `Unit|Spell`, bracketed with separators here -- matched with `instr`,
-- which they cannot. That is the
-- trade the second form is making, and it only applies when the user has actually asked for more
-- than one. `IN` would have been the obvious thing and is not available: the statement is static,
-- and an empty collection makes it `IN ()`, which SQLite will not parse.
--
-- Artwork treatment is read out of the payload rather than from a column of its own. It is the one
-- axis with no projection beside it, and adding one would be a schema change to every install's
-- downloaded cards for the sake of a filter. The payload is the serialised printing, and the only
-- field in it called `treatment` is the artwork's, so the substring is exact. Standard art carries
-- no such field at all -- the serialiser omits a default -- which is what `:standardArt` looks for.
--
-- Domains have no multi form here. The column is itself a delimited list, so "any of these" is a
-- set intersection and SQL cannot iterate both sides in one predicate -- see `SqlCardStore.search`,
-- which runs this once per chosen domain and merges.
searchPrintings:
SELECT payload FROM printing
WHERE game = :game
  AND (:language IS NULL OR language = :language)
  AND (:text IS NULL OR name_folded LIKE '%' || :text || '%')
  AND (:excludeText IS NULL OR name_folded NOT LIKE '%' || :excludeText || '%')
  AND (:cardType IS NULL OR card_type = :cardType)
  AND (:cardTypes IS NULL OR (card_type IS NOT NULL AND instr('|' || :cardTypes || '|', '|' || card_type || '|') > 0))
  AND (:rarity IS NULL OR rarity = :rarity)
  AND (:rarities IS NULL OR (rarity IS NOT NULL AND instr('|' || :rarities || '|', '|' || rarity || '|') > 0))
  AND (:maxCost IS NULL OR (cost IS NOT NULL AND cost <= :maxCost))
  AND (:minCost IS NULL OR (cost IS NOT NULL AND cost >= :minCost))
  AND (:domain IS NULL OR (domains IS NOT NULL AND domains LIKE '%' || :domain || '%'))
  AND (:treatment IS NULL OR payload LIKE '%"treatment":"' || :treatment || '"%')
  AND (:standardArt IS NULL OR (:standardArt = 1 AND payload NOT LIKE '%"treatment":%'))
ORDER BY name_folded
LIMIT :limit;

-- Whether a game has any card of one artwork treatment stored, so the filter offers only the
-- treatments there is something to find. One cheap existence check per value, and there are eight.
gameHasTreatment:
SELECT EXISTS(
    SELECT 1 FROM printing
    WHERE game = :game AND payload LIKE '%"treatment":"' || :treatment || '"%'
    LIMIT 1
);

-- Which of a game's sets are held *whole*, for the set list.
--
-- `complete = 1` and not merely present. The difference is the whole point: a set fetched part-way
-- leaves rows behind, so "is any of this here?" is true long before "is all of it here?" -- and the
-- row that offers a download has to ask the second question.
--
-- One query for the game rather than one per row. The language comes back with the set id because
-- completeness is per edition: a set held whole in English and part-way in French is complete in
-- one and not the other, and the caller knows which one the row would open in.
completeSetsInGame:
SELECT set_id, language FROM cached_set WHERE game = ? AND complete = 1;

-- What a game's downloaded cards actually contain, for the search screen's filters.
--
-- Read from the rows rather than from a game profile on purpose. A profile states what a game *can*
-- have; these state what is on this device, so the filter list cannot offer a rarity that would
-- match nothing. Nulls are dropped: a source that publishes no type is not a type.
cardTypesInGame:
SELECT DISTINCT card_type FROM printing
WHERE game = ? AND card_type IS NOT NULL AND card_type != ''
ORDER BY card_type;

raritiesInGame:
SELECT DISTINCT rarity FROM printing
WHERE game = ? AND rarity IS NOT NULL AND rarity != ''
ORDER BY rarity;

domainsInGame:
SELECT DISTINCT domains FROM printing
WHERE game = ? AND domains IS NOT NULL AND domains != ''
ORDER BY domains;

costRangeInGame:
SELECT MIN(cost) AS low, MAX(cost) AS high FROM printing
WHERE game = ? AND cost IS NOT NULL;

-- ==========================================================================
-- Eviction, the budget, and what a download left
-- ==========================================================================

touchSet:
UPDATE cached_set SET accessed_at = ? WHERE provider = ? AND set_id = ? AND language = ?;

-- A pin can land before the set does, and must survive it.
--
-- The download queue pins first on purpose: a set large enough to breach the ceiling would
-- otherwise be a candidate for the eviction its own write triggers. So pinning an absent set
-- writes a placeholder row -- no cards, no bytes -- and the write that follows fills it in,
-- carrying the flag forward. An `UPDATE` alone silently did nothing here, which made every
-- download unpinned and evictable at exactly the moment it was largest.
insertPinPlaceholder:
INSERT OR IGNORE INTO cached_set (
    provider, set_id, language, game, label, pinned, fetched_at, card_count, complete, bytes,
    accessed_at
) VALUES (?, ?, ?, ?, ?, 0, 0, 0, 0, 0, 0);

setPinned:
UPDATE cached_set SET pinned = ? WHERE provider = ? AND set_id = ? AND language = ?;

-- What browsing occupies. Pinned sets are excluded because they cannot be reclaimed: a ceiling
-- measured against bytes it has no power over is not a ceiling, and one import is enough to
-- exceed any sane limit -- after which every write evicts browsing records that together come
-- nowhere near it.
unpinnedBytes:
SELECT COALESCE(SUM(bytes), 0) FROM cached_set WHERE pinned = 0;

pinnedBytes:
SELECT COALESCE(SUM(bytes), 0) FROM cached_set WHERE pinned = 1;

evictionCandidates:
SELECT provider, set_id, language, bytes FROM cached_set
WHERE pinned = 0
ORDER BY accessed_at ASC;

deleteSetRows:
DELETE FROM printing WHERE provider = ? AND set_id = ? AND language = ?;

deleteCachedSet:
DELETE FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

-- Every downloaded set, named well enough for a screen to offer deleting it after everything else
-- is gone. The label is carried for exactly that reason: the file cache's pin markers were zero
-- bytes, so clearing the cache destroyed the only index from a hashed filename back to a set.
pinnedSets:
SELECT provider, set_id, language, game, label, card_count, bytes FROM cached_set
WHERE pinned = 1 ORDER BY label;

-- The storage screen, as one query instead of a directory walk and a string split per marker.
-- Distinct *sets*, not rows: a set held in two languages is two records and one set, which is a
-- ratio this project has got wrong three times.
pinnedByGame:
SELECT game,
       COUNT(DISTINCT set_id) AS sets,
       COUNT(*)               AS records,
       SUM(card_count)        AS cards,
       SUM(bytes)             AS bytes
FROM cached_set
WHERE pinned = 1 AND game != ''
GROUP BY game;

pinnedLanguagesForGame:
SELECT language, SUM(bytes) AS bytes FROM cached_set
WHERE pinned = 1 AND game = ? GROUP BY language ORDER BY bytes DESC;

deletePinnedForGame:
DELETE FROM cached_set WHERE pinned = 1 AND game = ?;

deletePrintingsForGame:
DELETE FROM printing WHERE game = ?;

hasSet:
SELECT COUNT(*) FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

languagesHeldForSet:
SELECT language FROM cached_set WHERE provider = ? AND set_id = ?;

cardCountForSet:
SELECT card_count FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

-- The set-open path needs the record's own metadata, not only its cards: how complete it is, and
-- when it was fetched, which is what staleness is measured from.
setMetadata:
SELECT label, pinned, fetched_at, card_count, complete FROM cached_set
WHERE provider = ? AND set_id = ? AND language = ?;

isSetPinned:
SELECT pinned FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

clearAll:
DELETE FROM printing;

clearAllSets:
DELETE FROM cached_set;
