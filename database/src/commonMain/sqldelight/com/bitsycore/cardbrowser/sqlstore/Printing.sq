-- One row per printing, per language.
--
-- The shape is deliberately the same identity the file cache uses: (provider, set, language) keys
-- a *set*, and (provider, card id, language) keys a printing. A schema that collapsed language
-- into a column would throw away the thing every layer of this app keys on.
--
-- `payload` is the serialised `CardPrinting`, exactly as the file cache stores it. The indexed
-- columns beside it are a projection for querying, not a second source of truth -- so a field this
-- spike does not model cannot be silently lost, and adding a filter later is a column and a
-- backfill rather than a migration of the record itself.
--
-- Nullable where the source said nothing. `cost` is NULL for a card with no cost *and* for a
-- source that does not publish one, and those are different facts -- the app's `Availability` has
-- three states for exactly this reason. A query that wants "cost under 4" must not sweep up
-- unknowns, so the predicates below test `IS NOT NULL` explicitly.
CREATE TABLE printing (
    provider      TEXT    NOT NULL,
    card_id       TEXT    NOT NULL,
    game          TEXT    NOT NULL,
    set_id        TEXT    NOT NULL,
    set_code      TEXT    NOT NULL,
    language      TEXT    NOT NULL,
    name          TEXT    NOT NULL,
    name_folded   TEXT    NOT NULL,
    card_type     TEXT,
    rarity        TEXT,
    cost          INTEGER,
    domains       TEXT,
    payload       TEXT    NOT NULL,
    PRIMARY KEY (provider, card_id, language)
);

-- Set membership is the commonest lookup by far: open a set, read its cards.
CREATE INDEX printing_set ON printing (provider, set_id, language);

-- Cross-set search, which is the query the file cache genuinely cannot do.
CREATE INDEX printing_name ON printing (game, name_folded);

-- What a download put on disk, so eviction and the storage screen can work in SQL rather than by
-- walking a directory. `pinned` is a flag rather than a separate table because it is one bit and
-- every query that cares about it also wants the row.
CREATE TABLE cached_set (
    provider    TEXT    NOT NULL,
    set_id      TEXT    NOT NULL,
    language    TEXT    NOT NULL,
    label       TEXT    NOT NULL,
    pinned      INTEGER NOT NULL DEFAULT 0,
    fetched_at  INTEGER NOT NULL,
    card_count  INTEGER NOT NULL,
    -- Whether every page was fetched. A partial set is cached too -- that is the whole point of
    -- `Completeness` -- and the grid says so on screen. Storing it is what keeps a filter applied
    -- to three of four pages from being presented as the answer for the set.
    complete    INTEGER NOT NULL DEFAULT 1,
    -- What this set occupies, so the budget is a SUM rather than a directory walk. Counted at
    -- write time from the payloads actually stored -- an estimate of the rows, not of the file,
    -- because SQLite's own page overhead is not a thing a user's ceiling should be spent on.
    bytes       INTEGER NOT NULL DEFAULT 0,
    -- Least-recently-*used*, not written. The file cache tracked this in memory and lost the
    -- ordering on every relaunch, which made a downloaded set and a glanced-at one look equally
    -- old. A column survives the process, which is the whole reason to move it here.
    accessed_at INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (provider, set_id, language)
);

-- Eviction reads in this order every time.
CREATE INDEX cached_set_evictable ON cached_set (pinned, accessed_at);

upsertPrinting:
INSERT OR REPLACE INTO printing (
    provider, card_id, game, set_id, set_code, language,
    name, name_folded, card_type, rarity, cost, domains, payload
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertCachedSet:
INSERT OR REPLACE INTO cached_set (
    provider, set_id, language, label, pinned, fetched_at, card_count, complete, bytes, accessed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- The set-open path.
printingsInSet:
SELECT payload FROM printing
WHERE provider = ? AND set_id = ? AND language = ?;

-- The storage screen, which is four directory walks today.
cachedSetCount:
SELECT COUNT(*) FROM cached_set;

pinnedSetCount:
SELECT COUNT(*) FROM cached_set WHERE pinned = 1;

printingCount:
SELECT COUNT(*) FROM printing;

languageBreakdown:
SELECT language, COUNT(*) AS total FROM cached_set GROUP BY language ORDER BY total DESC;

-- The prize: a filtered search across every downloaded set of a game, in one query.
--
-- Every predicate is opt-in via a NULL guard, which is how one statement serves a filter sheet
-- with any combination of chips set. `:excludeText` is the "does not contain" half the file cache
-- has no way to offer at all.
searchPrintings:
SELECT payload FROM printing
WHERE game = :game
  AND (:language IS NULL OR language = :language)
  AND (:text IS NULL OR name_folded LIKE '%' || :text || '%')
  AND (:excludeText IS NULL OR name_folded NOT LIKE '%' || :excludeText || '%')
  AND (:cardType IS NULL OR card_type = :cardType)
  AND (:rarity IS NULL OR rarity = :rarity)
  AND (:maxCost IS NULL OR (cost IS NOT NULL AND cost <= :maxCost))
  AND (:minCost IS NULL OR (cost IS NOT NULL AND cost >= :minCost))
  AND (:domain IS NULL OR (domains IS NOT NULL AND domains LIKE '%' || :domain || '%'))
ORDER BY name_folded
LIMIT :limit;

-- ==========================================================================
-- Eviction, the budget, and what a download left
-- ==========================================================================

touchSet:
UPDATE cached_set SET accessed_at = ? WHERE provider = ? AND set_id = ? AND language = ?;

setPinned:
UPDATE cached_set SET pinned = ? WHERE provider = ? AND set_id = ? AND language = ?;

-- What browsing occupies. Pinned sets are excluded because they cannot be reclaimed: a ceiling
-- measured against bytes it has no power over is not a ceiling, and one import is enough to
-- exceed any sane limit -- after which every write evicts browsing records that together come
-- nowhere near it.
unpinnedBytes:
SELECT COALESCE(SUM(bytes), 0) FROM cached_set WHERE pinned = 0;

pinnedBytes:
SELECT COALESCE(SUM(bytes), 0) FROM cached_set WHERE pinned = 1;

evictionCandidates:
SELECT provider, set_id, language, bytes FROM cached_set
WHERE pinned = 0
ORDER BY accessed_at ASC;

deleteSetRows:
DELETE FROM printing WHERE provider = ? AND set_id = ? AND language = ?;

deleteCachedSet:
DELETE FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

-- Every downloaded set, named well enough for a screen to offer deleting it after everything else
-- is gone. The label is carried for exactly that reason: the file cache's pin markers were zero
-- bytes, so clearing the cache destroyed the only index from a hashed filename back to a set.
pinnedSets:
SELECT provider, set_id, language, label, card_count, bytes FROM cached_set
WHERE pinned = 1 ORDER BY label;

hasSet:
SELECT COUNT(*) FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

languagesHeldForSet:
SELECT language FROM cached_set WHERE provider = ? AND set_id = ?;

cardCountForSet:
SELECT card_count FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

-- The set-open path needs the record's own metadata, not only its cards: how complete it is, and
-- when it was fetched, which is what staleness is measured from.
setMetadata:
SELECT label, pinned, fetched_at, card_count, complete FROM cached_set
WHERE provider = ? AND set_id = ? AND language = ?;

isSetPinned:
SELECT pinned FROM cached_set WHERE provider = ? AND set_id = ? AND language = ?;

clearAll:
DELETE FROM printing;

clearAllSets:
DELETE FROM cached_set;
