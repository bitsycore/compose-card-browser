.gradle/
build/
local.properties
.kotlin/
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
__pycache__/
*.pyc

# Xcode's per user state: which files were open, which scheme was last run.
# The project and the shared scheme are committed, this is not.
xcuserdata/
*.xcuserdatad/
.DS_Store

# Signing keys. The publishing key never goes in here.
#
# `androidApp/debug.keystore` is the exception and is committed on purpose: it is AGP's own debug
# credentials, and sharing it is what lets a build from one computer install over a build from
# another instead of demanding an uninstall. It signs debug and local release builds. The store
# artifact is signed with `publish.jks`, which stays out.
*.jks
*.keystore
!androidApp/debug.keystore

# Scratch space for provider research: captured API responses and device
# screenshots. Evidence for one afternoon, not for the repository.
.research/

# Built APKs kept outside build/ so a clean does not delete them. Binaries stay
# out of git.
/dist/
/androidApp/debug/
/androidApp/release/
